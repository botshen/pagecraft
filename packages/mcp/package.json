{
  "name": "pagecraft-mcp",
  "version": "0.2.1",
  "description": "Zero-dependency local MCP bridge connecting Claude Code, Cursor, Codex CLI, and Windsurf to PageCraft's live authenticated browser DOM, Element Picker, and Dual-Engine runtime over 127.0.0.1.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "pagecraft-mcp": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ws-server": {
      "types": "./dist/ws-server.d.ts",
      "default": "./dist/ws-server.js"
    },
    "./mcp-server": {
      "types": "./dist/mcp-server.d.ts",
      "default": "./dist/mcp-server.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/botshen/pagecraft.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://pagecraft.shenxin.space",
  "bugs": {
    "url": "https://github.com/botshen/pagecraft/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "pagecraft",
    "browser-extension",
    "chrome-extension",
    "claude-code",
    "cursor",
    "codex",
    "windsurf",
    "userscript",
    "dom-inspector"
  ],
  "scripts": {
    "build": "../../node_modules/.bin/tsc -p ./tsconfig.json && node -e \"const fs=require('node:fs');fs.chmodSync('./dist/cli.js',0o755)\"",
    "prepublishOnly": "npm run build",
    "start": "node ./dist/cli.js",
    "dev": "node --experimental-strip-types ./src/cli.ts",
    "typecheck": "../../node_modules/.bin/tsc --noEmit -p ./tsconfig.json"
  }
}
